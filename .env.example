# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION FOR GOODWIN GROW HRMS
# ------------------------------------------------------------------------------
# 1. Create a free project at https://database.new (or https://supabase.com)
# 2. Go to Project Settings -> API to copy your project URL and keys
# 3. Copy this file to .env.local and paste your credentials below:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# DIRECT POSTGRESQL CONNECTION STRING (Optional - for Prisma / Migrations)
# ------------------------------------------------------------------------------
# Project Settings -> Database -> Connection String -> URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL (Optional - for real inbox delivery)
# ------------------------------------------------------------------------------
# Resend API Key (https://resend.com)
RESEND_API_KEY=re_123456789
